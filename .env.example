# Copia este archivo como .env y llena los valores. El .env real NUNCA se sube al repositorio.

# Cadena de conexión de PostgreSQL (local, Render, Neon, Supabase...)
# En producción agrega ?sslmode=require si tu proveedor lo pide.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chess_shop?schema=public"

# Secreto con el que se firman los JWT. Usa un valor largo y aleatorio, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=bebd7bf23419f2e82da4874ab36edeff38b644b40a75765786392913d13a44519df82ec6758583b4458e8b8ddcc75ddd
# Tiempo de vida del token: segundos (3600) o con unidad (15m, 2h, 1d)
JWT_EXPIRES_IN=2h

# Puerto de la API (Render y Railway lo asignan solos)
PORT=3001

# Orígenes permitidos por CORS, separados por coma (URL del frontend en Vercel, sin "/" al final)
FRONTEND_URL=http://localhost:3000
