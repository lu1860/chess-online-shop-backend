{
  "name": "chess-online-shop-backend",
  "version": "1.0.0",
  "description": "API REST de ChessOnline Shop: catálogo de productos de ajedrez, pedidos y autenticación con JWT",
  "type": "module",
  "main": "dist/src/app.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "nodemon --ext ts,json --watch src --exec \"tsx ./src/app.ts\"",
    "build": "prisma generate && tsc",
    "start": "prisma migrate deploy && node ./dist/src/app.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "seed": "prisma db seed",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-reporter=spec tests/*.test.ts"
  },
  "keywords": ["express", "prisma", "postgresql", "jwt", "ajedrez"],
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcrypt": "^6.0.0",
    "class-validator": "^0.15.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "prisma": "^7.10.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "nodemon": "^3.1.14",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
